PORT=5000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your_jwt_secret_here_change_in_production_minimum_32_chars
JWT_EXPIRE=24h

# AES Encryption Master Key (64 hex chars = 32 bytes)
ENCRYPTION_MASTER_KEY=your_64_hex_char_encryption_master_key_change_in_production_here

# CORS
FRONTEND_URL=http://localhost:5173

# File Upload
MAX_FILE_SIZE=10485760

# Storage paths
IPFS_STORAGE_PATH=./storage/ipfs
BLOCKCHAIN_STORAGE_PATH=./storage/blockchain
